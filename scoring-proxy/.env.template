# SSI Admin credentials for registration feature
# Copy this file to .env and fill in your values
SSI_ADMIN_EMAIL=your-admin@example.com
SSI_ADMIN_PASSWORD=your-password
SSI_ADMIN_API_KEY=your-api-key

# Test credentials (required for integration tests)
# Use separate test account credentials, not production credentials
SSI_EMAIL=test-user@example.com
SSI_PASSWORD=test-password
SSI_API_KEY=test-api-key

# Platform — Match Management Platform settings
# PostgreSQL connection string for platform data (accounts, tenants)
DATABASE_URL=postgresql://user:password@localhost:5432/platform

# AES-256-GCM key for encrypting SSI credentials at rest (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_CREDENTIALS_KEY=

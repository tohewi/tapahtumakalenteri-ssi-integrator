# ============================================================
# Environment Variables Reference
# ============================================================
# Copy to .env for local development. NEVER commit .env files.
# For Render, set via Dashboard → Environment or Environment Groups.
# For GitHub Actions (PR previews), set as repo secrets.
# ============================================================

# ── Core ──
NODE_ENV=production
LOG_LEVEL=info                          # debug | info | warn | error
APP_URL=http://localhost:3001           # Public URL of this service

# ── Database ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_SCHEMA=                              # Leave empty for 'public'. PR previews use 'pr_{N}'

# ── Redis (session storage) ──
REDIS_URL=redis://host:6379

# ── Session ──
SESSION_SECRET=                         # Random string. Generate: openssl rand -base64 32

# ── Encryption Keys (CRITICAL — see docs/design/key-management.md) ──
# These keys encrypt SSI credentials and MFA secrets in the database.
# Losing these keys means encrypted data becomes unreadable.
# Must be exactly 64 hex characters (32 bytes / AES-256).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_CREDENTIALS_KEY=               # AES-256-GCM key for SSI credential encryption
MFA_SECRET_KEY=                         # Reserved for future per-field MFA encryption

# ── SSI Integration ──
SSI_ADMIN_EMAIL=                        # SSI admin account email (background sync)
SSI_ADMIN_PASSWORD=                     # SSI admin account password
SSI_ADMIN_API_KEY=                      # SSI API key (optional)
SSI_BASE_URL=https://shootnscoreit.com  # SSI base URL

# ── Email (Resend) ──
RESEND_API_KEY=                         # Resend.com API key
EMAIL_FROM=no-reply@example.com         # Sender address (must be verified in Resend)

# ── Staffing ──
STAFFING_CRON_SECRET=                   # Secret for staffing cron webhook
STAFFING_API_URL=                       # Staffing API endpoint

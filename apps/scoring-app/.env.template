# SSI Admin credentials for registration feature
# Copy this file to .env and fill in your values

# PostgreSQL connection (R8.0 platform store — optional, graceful degradation if not set)
DATABASE_URL=postgresql://user:password@localhost:5432/ssi_platform
# DB_SCHEMA=public  # Optional: override schema (used for PR preview isolation)

# Platform app settings (R8.0 multi-tenant)
# PLATFORM_SESSION_SECRET=change-me-in-production
# PLATFORM_JWT_SECRET=change-me-in-production
# ENCRYPTION_KEY=hex-encoded-32-byte-key-for-aes-256
SSI_ADMIN_EMAIL=your-admin@example.com
SSI_ADMIN_PASSWORD=your-password
SSI_ADMIN_API_KEY=your-api-key

# Test credentials (required for integration tests)
# Use separate test account credentials, not production credentials
SSI_EMAIL=test-user@example.com
SSI_PASSWORD=test-password
SSI_API_KEY=test-api-key
